# --- Gemini on Vertex AI (no API key needed; uses the service account) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1


# Gemini via Google AI / Generative Language API (API key, no gcloud login)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=AQ.Ab8RN6IxPjTO0p32Imw2NCSZ86PhtQz81kpG_kyTsWgJ_WoaGQ
MEDBRIDGE_MODEL=gemini-2.5-flash

# Model the autonomous agent reasons with. gemini-2.5-flash is fast, cheap, and
# strong at tool use; gemini-2.5-pro is more capable. (gemini-2.0-* is retired.)
MEDBRIDGE_MODEL=gemini-2.5-flash

# Local dev only: if you'd rather use a Gemini API key than Vertex, set
# GOOGLE_GENAI_USE_VERTEXAI=FALSE and provide GOOGLE_API_KEY instead.
# GOOGLE_API_KEY=

# --- TBO (TekTravels) Universal Air API -----------------------------------
# Override the whitelisted EndUserIp without editing the JSON below (useful when
# the deploy target's public IP differs from what TBO has whitelisted). TBO binds
# the auth token to the request's SOURCE IP, so this must match the server's real
# public IP, and that IP must be whitelisted by TBO, or Search returns
# "Invalid Token". The travel flow is read-only and stops before payment — there
# is no ticketing/booking step, so there is no live-ticketing flag.
# TBO_END_USER_IP=

# --- TBO credentials (the real .env is a JSON object with these four keys) ---
# EndUserIp MUST be the server's real public IP, and that IP must be whitelisted
# by TBO, or Authenticate/Search fail with an IP-authorization error.
{
  "UserName": "your-tbo-username",
  "Password": "your-tbo-password",
  "ClientId": "your-tbo-clientid",
  "EndUserIp": "your-server-public-ip"
}