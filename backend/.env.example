# --- Gemini via Google AI API key (simplest; works the same on every laptop) ---
# Get a key: Google Cloud Console -> APIs & Services (or https://aistudio.google.com/apikey)
# Make sure the "Generative Language API" is enabled on the key's project.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your_gemini_api_key_here

# Model the autonomous agent reasons with. gemini-2.5-flash is fast, cheap, and
# strong at tool use; gemini-2.5-pro is more capable. (gemini-2.0-* is retired.)
MEDBRIDGE_MODEL=gemini-2.5-flash

# --- Alternative: Gemini on Vertex AI (uses Google Cloud free credits) ---
# Comment out the two lines above and use these instead. Requires either
# `gcloud auth application-default login` locally, or a service account when deployed.
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
