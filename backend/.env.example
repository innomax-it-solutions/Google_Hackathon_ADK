# --- Gemini: choose ONE auth mode -----------------------------------------
# Default: Google AI Studio API key (no gcloud/Vertex needed for the LLM).
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-ai-studio-api-key

# Alternative: Gemini on Vertex AI (uses gcloud ADC / the Cloud Run service
# account instead of an API key). To use this, set the flag below to TRUE and
# remove GOOGLE_API_KEY above.
# GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Model the agent reasons with. gemini-2.5-flash is fast & cheap; -pro is
# stronger. (gemini-2.0-* is retired.)
MEDBRIDGE_MODEL=gemini-2.5-flash

# GCP project — REQUIRED for Firestore auth and voice transcription regardless
# of the Gemini mode above (those use ADC / a service account, not the API key).
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Auth: registration / login (Firestore + JWT) -------------------------
# Users are stored in Firestore (collection `users`). No DATABASE_URL needed:
# Firestore uses Application Default Credentials — locally the same gcloud auth
# that powers Vertex AI (run `gcloud auth application-default login`), and in
# production the Cloud Run service account. The project comes from
# GOOGLE_CLOUD_PROJECT above. To use a local emulator instead, set
# FIRESTORE_EMULATOR_HOST=localhost:8080 (start it with the gcloud/firebase CLI).
#
# Sign the JWT session tokens. Generate a strong secret, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
# Demo account seeded on startup so the README credentials keep working.
DEMO_ADMIN_EMAIL=admin@healtour.com
DEMO_ADMIN_PASSWORD=healtour@123
DEMO_ADMIN_NAME=Healtour Admin

# --- TBO (TekTravels) Universal Air API -----------------------------------
# Override the whitelisted EndUserIp without editing the JSON below (useful when
# the deploy target's public IP differs from what TBO has whitelisted). TBO binds
# the auth token to the request's SOURCE IP, so this must match the server's real
# public IP, and that IP must be whitelisted by TBO, or Search returns
# "Invalid Token". The travel flow is read-only and stops before payment — there
# is no ticketing/booking step, so there is no live-ticketing flag.
# TBO_END_USER_IP=

# --- TBO credentials (the real .env is a JSON object with these four keys) ---
# EndUserIp MUST be the server's real public IP, and that IP must be whitelisted
# by TBO, or Authenticate/Search fail with an IP-authorization error.
{
  "UserName": "your-tbo-username",
  "Password": "your-tbo-password",
  "ClientId": "your-tbo-clientid",
  "EndUserIp": "your-server-public-ip"
}