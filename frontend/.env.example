# MedBridge Frontend — Environment Variables
# Copy this file to .env and update the values.
#
# In development the Vite dev server proxies /chat and /run to VITE_API_URL
# automatically (configured in vite.config.js), so VITE_API_URL only matters
# when overriding the default localhost:8000 target or in production builds.

# Backend URL (where the FastAPI server is running)
VITE_API_URL=http://localhost:8000

# Login credentials (frontend-only demo auth — gates /chat and /forms).
# Vite only exposes variables prefixed with VITE_ to the client.
VITE_ADMIN_EMAIL=admin@healtour.com
VITE_ADMIN_PASSWORD=healtour@123
