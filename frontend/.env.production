# Production build env — Vite bakes these into the bundle at `npm run build`.
# VITE_API_URL points the SPA (and the wss:// voice socket) at the Cloud Run backend.
VITE_API_URL=https://medbridge-api-702861382786.us-central1.run.app

# Demo login gate (frontend-only). Kept here (not in .env) because .env is
# git-ignored and therefore excluded from the Cloud Build upload.
VITE_ADMIN_EMAIL=admin@healtour.com
VITE_ADMIN_PASSWORD=healtour@123
